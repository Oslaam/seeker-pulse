generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Dapp {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  description        String?
  shortDescription   String?
  website            String?
  iconUrl            String?
  bannerUrl          String?
  packageName        String?
  deepLink           String?
  developerName      String?
  developerWebsite   String?
  status             String    @default("active")
  isActive           Boolean   @default(true)
  isVerified         Boolean   @default(false)
  isSeekerCompatible Boolean   @default(false)
  rating             Float?
  reviewCount        Int?
  pulseScore         Int?
  source             String
  sourceId           String?
  sourceUrl          String?
  metadataUri        String?
  verifiedAt         DateTime?
  firstSeenAt        DateTime  @default(now())
  lastSeenAt         DateTime  @updatedAt
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  releases     DappRelease[]
  categories   DappCategory[]
  tags         DappTag[]
  syncLogs     DappSyncLog[]
  interactions WalletDappInteraction[]

  @@index([packageName])
  @@index([slug])
  @@index([status])
  @@index([isActive])
  @@index([isSeekerCompatible])
  @@index([pulseScore])
  @@index([updatedAt])
  @@index([name])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dapps DappCategory[]

  @@index([slug])
}

model DappCategory {
  dappId     String
  categoryId String
  dapp       Dapp     @relation(fields: [dappId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([dappId, categoryId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dapps DappTag[]

  @@index([slug])
}

model DappTag {
  dappId String
  tagId  String
  dapp   Dapp   @relation(fields: [dappId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dappId, tagId])
}

model DappRelease {
  id          String    @id @default(cuid())
  dappId      String
  version     String
  versionCode String?
  packageName String?
  releaseDate DateTime?
  metadataUrl String?
  apkUrl      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  dapp Dapp @relation(fields: [dappId], references: [id], onDelete: Cascade)

  @@unique([dappId, version])
  @@index([packageName])
  @@index([releaseDate])
}

model DappSyncLog {
  id          String    @id @default(cuid())
  provider    String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  discovered  Int       @default(0)
  valid       Int       @default(0)
  invalid     Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  unchanged   Int       @default(0)
  deactivated Int       @default(0)
  failed      Int       @default(0)
  error       String?
  status      String    @default("running")

  dappId String?
  dapp   Dapp?   @relation(fields: [dappId], references: [id], onDelete: SetNull)

  @@index([provider])
  @@index([status])
  @@index([startedAt])
}

model Mission {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  kind        String
  category    String    @default("discovery")
  target      Int       @default(1)
  xp          Int       @default(10)
  isActive    Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  progress MissionProgress[]

  @@index([isActive])
  @@index([category])
}

model WalletUser {
  id            String                  @id @default(cuid())
  walletAddress String                  @unique
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  challenges    WalletChallenge[]
  sessions      WalletSession[]
  interactions  WalletDappInteraction[]
  progress      MissionProgress[]
  achievements  WalletAchievement[]
}

model WalletChallenge {
  id           String    @id @default(cuid())
  walletUserId String
  nonce        String    @unique
  message      String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  walletUser WalletUser @relation(fields: [walletUserId], references: [id], onDelete: Cascade)

  @@index([walletUserId])
  @@index([expiresAt])
}

model WalletSession {
  id           String   @id @default(cuid())
  walletUserId String
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  walletUser WalletUser @relation(fields: [walletUserId], references: [id], onDelete: Cascade)

  @@index([walletUserId])
  @@index([expiresAt])
}

model WalletDappInteraction {
  id            String   @id @default(cuid())
  walletUserId  String
  dappId        String
  firstOpenedAt DateTime @default(now())
  lastOpenedAt  DateTime @default(now())
  openCount     Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  walletUser WalletUser @relation(fields: [walletUserId], references: [id], onDelete: Cascade)
  dapp       Dapp       @relation(fields: [dappId], references: [id], onDelete: Cascade)

  @@unique([walletUserId, dappId])
  @@index([walletUserId, lastOpenedAt])
  @@index([walletUserId, openCount])
}

model MissionProgress {
  id             String    @id @default(cuid())
  walletAddress  String
  walletUserId   String?
  missionId      String
  progress       Int       @default(0)
  completedAt    DateTime?
  proofSignature String?
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  mission    Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  walletUser WalletUser? @relation(fields: [walletUserId], references: [id], onDelete: Cascade)

  @@unique([walletAddress, missionId])
  @@index([walletAddress])
  @@index([completedAt])
}

model Achievement {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  kind        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  awards WalletAchievement[]
}

model WalletAchievement {
  id            String   @id @default(cuid())
  walletAddress String
  walletUserId  String?
  achievementId String
  awardedAt     DateTime @default(now())

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  walletUser  WalletUser? @relation(fields: [walletUserId], references: [id], onDelete: Cascade)

  @@unique([walletAddress, achievementId])
  @@index([walletAddress])
}
