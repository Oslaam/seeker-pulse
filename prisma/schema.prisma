generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Dapp {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  description        String?
  shortDescription   String?
  website            String?
  iconUrl            String?
  bannerUrl          String?
  packageName        String?
  deepLink           String?
  developerName      String?
  developerWebsite   String?
  status             String   @default("active")
  isActive           Boolean  @default(true)
  isVerified         Boolean  @default(false)
  isSeekerCompatible Boolean  @default(false)
  rating             Float?
  reviewCount        Int?
  pulseScore         Int?
  source             String
  sourceId           String?
  sourceUrl          String?
  metadataUri        String?
  verifiedAt         DateTime?
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @updatedAt
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  releases   DappRelease[]
  categories DappCategory[]
  tags       DappTag[]
  syncLogs   DappSyncLog[]

  @@index([packageName])
  @@index([slug])
  @@index([status])
  @@index([isActive])
  @@index([isSeekerCompatible])
  @@index([pulseScore])
  @@index([updatedAt])
  @@index([name])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dapps DappCategory[]

  @@index([slug])
}

model DappCategory {
  dappId     String
  categoryId String
  dapp       Dapp     @relation(fields: [dappId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([dappId, categoryId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dapps DappTag[]

  @@index([slug])
}

model DappTag {
  dappId String
  tagId  String
  dapp   Dapp   @relation(fields: [dappId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dappId, tagId])
}

model DappRelease {
  id          String    @id @default(cuid())
  dappId      String
  version     String
  versionCode String?
  packageName String?
  releaseDate DateTime?
  metadataUrl String?
  apkUrl      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  dapp Dapp @relation(fields: [dappId], references: [id], onDelete: Cascade)

  @@unique([dappId, version])
  @@index([packageName])
  @@index([releaseDate])
}

model DappSyncLog {
  id          String    @id @default(cuid())
  provider    String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  discovered  Int       @default(0)
  valid       Int       @default(0)
  invalid     Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  unchanged   Int       @default(0)
  deactivated Int       @default(0)
  failed      Int       @default(0)
  error       String?
  status      String    @default("running")

  dappId String?
  dapp   Dapp?   @relation(fields: [dappId], references: [id], onDelete: SetNull)

  @@index([provider])
  @@index([status])
  @@index([startedAt])
}
