{
  "name": "seeker-pulse",
  "version": "1.0.0",
  "description": "Unofficial daily activity check for Solana Seeker / Seed Vault Wallet users.",
  "type": "module",
  "main": "src/dist/server.js",
  "scripts": {
    "build": "npx prisma generate && tsc -p tsconfig.json && tsc src/page/app.ts --target ES2020 --module ES2020 --lib ES2020,DOM --strict --skipLibCheck --outDir public",
    "rebuild": "npm rebuild",
    "start": "npm run build && node src/dist/server.js",
    "dev": "npm run build && node --watch src/dist/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev --name dapp-catalog",
    "sync:dapps": "node src/dist/scripts/sync-dapps.js",
    "sync:dapps:dry": "node src/dist/scripts/sync-dapps.js --dry-run",
    "dapps:snapshot:seekertracker": "node src/dist/scripts/snapshot-seekertracker.js",
    "dapps:refresh": "npm run dapps:snapshot:seekertracker && npm run sync:dapps -- --file data/dapps.seekertracker.snapshot.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@onsol/tldparser": "^0.5.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@solana/web3.js": "1.95.3",
    "@vercel/node": "^12.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "rpc-websockets": "9.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
